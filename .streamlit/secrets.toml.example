# Copy these two lines into: Streamlit Cloud -> your app -> Settings -> Secrets
# (never commit the real values to GitHub)

APP_PASSWORD = "choose-a-long-password-here"

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4 friendly).
# If your DB password has special characters (@ : / # ?) URL-encode them, e.g. @ becomes %40
DATABASE_URL = "postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
